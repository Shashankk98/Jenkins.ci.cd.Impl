[Unit]
Description={{ app_name }} Java Application
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory={{ deploy_path }}
ExecStart=/usr/bin/java {{ java_opts }} -jar {{ deploy_path }}/{{ app_name }}.jar
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=append:{{ deploy_path }}/logs/stdout.log
StandardError=append:{{ deploy_path }}/logs/stderr.log

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ deploy_path }}

[Install]
WantedBy=multi-user.target

